# Origin of the backend, without the /api prefix. The client appends it.
# Defaults to http://localhost:8000 (the backend's own default port) if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# This origin must also appear in the backend's ALLOWED_ORIGINS, or every
# request fails: reads are blocked by CORS, and writes come back as a plain
# 403 {"error":"Forbidden"} from the backend's own origin check.
